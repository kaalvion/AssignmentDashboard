{
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build && cp -r frontend/dist ./dist 2>/dev/null || true",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/penalties",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

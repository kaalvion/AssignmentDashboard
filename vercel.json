{
  "version": 2,
  "buildCommand": "cd frontend 2>/dev/null || true; npm install && npm run build && cp -r dist ../ 2>/dev/null || true",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
